[package]
name = "steam-cm-protocol"
version = "0.4.1"
edition = "2024"
description = "Steam client protocol implementation for native Rust applications"
homepage = "https://github.com/LargeModGames/steam-cm-protocol"
documentation = "https://docs.rs/steam-cm-protocol"
repository = "https://github.com/LargeModGames/steam-cm-protocol"
keywords = ["steam", "protocol", "client", "websocket"]
categories = ["api-bindings", "network-programming"]
authors = ["LargeModGames <LargeModGames@gmail.com>"]
license = "MIT"
readme = "README.md"
build = "build.rs"
exclude = [
    ".github/",
    "target/",
]

[dependencies]
base64 = "0.22"
bytes = "1"
flate2 = "1"
futures-util = "0.3"
prost = "0.14"
rand = "0.8"
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
rsa = "0.9"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
thiserror = "2"
tokio = { version = "1", features = ["full"] }
tokio-tungstenite = { version = "0.27", features = ["rustls-tls-webpki-roots"] }
tracing = "0.1"

[build-dependencies]
prost-build = "0.14"
protox = "0.9"
