# Searching. `what` is a word the code fixes — audio, video, image, item,
# game, layout — and each language builds the whole phrase around the count.
search-by-name = { $what ->
    [audio] ऑडियो फ़ाइलें नाम से खोजें
    [video] वीडियो फ़ाइलें नाम से खोजें
   *[image] छवियाँ नाम से खोजें
    }
