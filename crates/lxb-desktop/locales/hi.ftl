       *[other] छवियाँ
        }
    [item] { $count ->
        [one] आइटम
       *[other] आइटम
        }
    [game] { $count ->
        [one] गेम
       *[other] गेम
        }
   *[layout] { $count ->
        [one] लेआउट
       *[other] लेआउट
        }
