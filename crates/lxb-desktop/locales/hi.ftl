    [audio] { $count ->
        [one] ऑडियो फ़ाइल
       *[other] ऑडियो फ़ाइलें
        }
    [video] { $count ->
        [one] वीडियो फ़ाइल
       *[other] वीडियो फ़ाइलें
        }
    [image] { $count ->
